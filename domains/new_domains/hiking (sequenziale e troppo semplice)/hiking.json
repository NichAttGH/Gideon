{
  "problem_prefix": "hiking",
  "domain_name": "hiking",
  "objects_pools": {
      "car_pool":{
        "object_type": "car",
        "count": 2,
        "mutex": true,
        "name_prefix": "c"
        },
      "tent_pool":{
        "object_type": "tent",
        "count": 1,
        "mutex": true,
        "name_prefix": "t"
      },
      "couple_pool":{
        "object_type": "couple",
        "count":1,
        "sequential": true,
        "name_prefix": "cp"
      },
      "starting_place":{
        "object_type": "place",
        "count":1,
        "name_prefix": "start"
      },
      "place_pool":{
        "object_type": "place",
        "count":1,
        "name_prefix": "pl"
      },
      "ending_place":{
        "object_type":"place",
        "count":1,
        "name_prefix": "end"
      },
      "person_pool":{
        "object_type": "person",
        "count":2,
        "sequential": true,
        "name_prefix": "p"
      }
  },
  "predicates_pools": {
    "all_predicates_init":{
      "partners":{
        "count": 1,
        "args": ["couple_pool$0", "person_pool$1", "person_pool$1+1"]
      },
      "at_person":{
        "count": 2,
        "args": ["person_pool$1", "starting_place"]
      },
      "walked":{
        "count": 1,
        "args": ["couple_pool$0", "starting_place"]
      },
      "at_tent":{
        "count": 1,
        "args": ["tent_pool", "starting_place"]
      },
      "at_car":{
        "count": 2,
        "args": ["car_pool", "starting_place"]
      },
      "down":{
        "count": 1,
        "args": ["tent_pool"]
      }
    },
    "all_predicates_goal":{
      "walked":{
        "count": 1,
        "args": ["couple_pool$0", "ending_place"]
      }
    }
  },
  "constant_initial_state": "(next start0 pl0)(next pl0 end0)",
  "init_state": {
    "predicates": {
      "mutex_pools": [],
      "mutex_prob": [],
      "pools": ["all_predicates_init"]
    },
    "functions": {
      "total-cost": 0.0
    }
  },
  "constant_goal_state": "",
  "goal_state": {
    "predicates": {
      "mutex_pools": [],
      "mutex_prob": [],
      "pools": ["all_predicates_goal"]
    },
    "functions": {}
  },
  "metric": {
    "optimize": "minimize",
    "function": "total-cost"
  }
}